# Copy this file to .env.local for local development.
# In production (Vercel), set these under Project Settings -> Environment Variables.

# Your Anthropic API key. Server-side only -- never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# The shared password Membership Plus members use to enter the tools site.
SITE_PASSWORD=choose-a-shared-password

# A long random string used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
